// The settings the fixture installation steps refer to. See
// installation-steps.kdl beside this file for why the fixture exists.

- name="user-name" default-value=""
- name="encrypt-root-partition" default-value=#false
- name="timezone" default-value=""
- name="install-disk" default-value=""
- name="install-disk-description" default-value=""

// A radiolist dialog: several settings sharing one dialog-name.
- name="profile-default" dialog-name="User Profile" short-description="Standard" default-value=#true {
    arch-packages ""
}
- name="profile-server" dialog-name="User Profile" short-description="Server" default-value=#false {
    arch-packages ""
}

// A checklist dialog. `install-extra-unavailable` is never available, which is
// what proves that step-is-answered asks about the settings a dialog would
// really show rather than about every setting that names it.
- name="install-extra-editor" dialog-name="Extras" short-description="An editor" default-value=#false {
    arch-packages "vim"
}
- name="install-extra-shell" dialog-name="Extras" short-description="A shell" default-value=#false {
    arch-packages "zsh"
}
- name="install-extra-unavailable" dialog-name="Extras" short-description="Never shown" available="`profile-server AND NOT profile-server`" default-value=#false {
    arch-packages ""
}

// Settings that declare a user namespace permission and sysctl values. Both keys
// are collected across the settings that are switched on, which is what lets a
// package ask for what it needs beside itself instead of every setting having to
// repeat the safe default.
- name="needs-userns-a" default-value=#true {
    userns-allow "/usr/bin/bwrap"
    sysctl {
        - "kernel.test_alpha" "1"
    }
}

// Names the same executable as the setting above. Flatpak and Bubblejail both ask
// for bwrap, so the allowlist has to be a set: the loader treats a repeated path
// as a second entry and would count it twice.
- name="needs-userns-b" default-value=#true {
    userns-allow "/usr/bin/bwrap" "/usr/bin/other"
}

- name="needs-userns-off" default-value=#false {
    userns-allow "/usr/bin/never"
    sysctl {
        - "kernel.test_beta" "9"
    }
}

// Asks for the same value as needs-userns-a. Two settings agreeing about a key is
// not a conflict and must not stop an installation.
- name="agrees-with-a" default-value=#true {
    sysctl {
        - "kernel.test_alpha" "1"
    }
}

// Disagrees with needs-userns-a about the same key. Off by default so that the
// fixture describes an installable machine; the test switches it on, which is how
// a user reaches this state - by choosing two options that contradict each other.
- name="conflicts-with-a" default-value=#false {
    sysctl {
        - "kernel.test_alpha" "0"
    }
}
