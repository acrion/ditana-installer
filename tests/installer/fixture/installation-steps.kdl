// A miniature installer configuration for the answer-file tests.
//
// It is deliberately not a copy of ditana-config: the tests are about how an
// answer file is matched against whatever configuration is loaded, not about
// the real one, and a fixture that never changes keeps a failure pointing at
// the answer-file code rather than at last week's configuration commit.
//
// No setting here carries a `detect` expression, so loading it runs no
// hardware detection and the result is the same on every machine.

- name="user-name" type="ask-for-setting" validation="name" instruction="""
User name for the new system.
"""

- name="encrypt-root-partition" type="ask-for-yes-no" instruction="""
Encrypt the root partition?
"""

- name="User Profile" type="radiolist" instruction="""
Pick a profile.
"""

- name="Extras" type="checklist" instruction="""
Pick what to install.
"""

- name="Configuration Categories" type="categories" {
    categories {
        - name="User Profile" type="radiolist" instruction="Pick a profile."
        - name="Extras" type="checklist" instruction="Pick what to install."
    }
}

// Asked here solely for the server profile, and in Advanced Settings beneath
// for every profile, just as ditana-config does with host-name and the
// developer profile. The value ends up in /etc/hostname regardless.
- name="host-name" type="ask-for-setting" validation="name" available="`profile-server`" instruction="""
Name of the new machine.
"""

// A category menu nested within a category menu. In ditana-config, user-id
// and user-group are asked here and in no other location, and an unattended
// run skips the outer menu as a whole.
- name="Advanced Settings" type="categories" {
    categories {
        - name="host-name" type="ask-for-setting" validation="name" instruction="Name of the new machine."
        - name="User Configuration" type="categories" {
            categories {
                - name="user-id" type="ask-for-setting" validation="integer" extra-validation="$_ ∈ 1000..60000" instruction="ID of the user."
                - name="user-group" type="ask-for-setting" validation="integer" extra-validation="$_ ∈ 1000..60000" instruction="Group of the user."
            }
        }
        // A whole-number box permitting 0, with the range ditana-config gives it.
        - name="sudo-timeout" type="ask-for-setting" validation="integer" extra-validation="$_ ∈ 0..480" instruction="Minutes sudo remembers the password."
    }
}

// A box for a numerical value including a fraction: the screen diagonal in
// inches, as ditana-config asks for it.
- name="display-size" type="ask-for-setting" validation="number" instruction="""
Screen diagonal in inches.
"""

- name="choose-region-or-timezone" type="procedure"
- name="choose-specific-timezone" type="procedure"
- name="select-disk" type="procedure"
- name="switch-on-logging" type="procedure"
