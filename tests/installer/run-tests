# The tests for unattended installation. They need no network, no terminal and
# no root, and they run against the fixture configuration beside them rather
# than against the one ditana-config publishes, so a failure here is about the
# installer and not about last week's configuration commit.

set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")"

# Settings.rakumod and Autoinstall.rakumod both call json-kdl-converter as a
# sibling of the running program. build.sh builds it from the configuration
# archive; without it there is nothing to test against, and saying so beats a
# stack trace about a missing file.
if [[ ! -x json-kdl-converter ]]; then
    echo "json-kdl-converter is missing (build.sh builds it into airootfs/root/)." >&2
    exit 1
fi

# The installer's own modules come from airootfs/root/.raku, which is
# /root/.raku in the ISO and therefore the ordinary home repository there.
# Outside the ISO it is nobody's home, so a test run has to name it -- on the
# build host there is no other JSON::Fast to be had, and without this the
# tests fail on a missing module rather than on anything they assert.
RAKU_REPO=$(readlink -f ../../airootfs/root/.raku)
if [[ -d "$RAKU_REPO" ]]; then
    export RAKULIB="inst#$RAKU_REPO"
fi

# The names are collected rather than only counted, because this suite is run by
# build.sh: a test that fails scrolls away behind the ones after it, and `set -e`
# then ends the build without a word. What is left on the screen is the last
# test file, passing.
failed=()
for test in ./*.t; do
    echo "== $test"
    if ! raku "$test"; then
        failed+=("$test")
    fi
done

if (( ${#failed[@]} )); then
    echo
    echo "FAILED: ${#failed[@]} of the installer tests did not pass:" >&2
    printf '    %s\n' "${failed[@]}" >&2
    exit 1
fi

echo
echo "All installer tests passed."
exit 0
