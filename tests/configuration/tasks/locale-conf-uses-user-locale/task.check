note: locale.conf should use user locale for all categories
generator: <<RAKU
!raku

for <LC_COLLATE LC_CTYPE LC_MESSAGES LC_NUMERIC LANG> -> $i {
   # in Raku you can use double quotes " instead of \ to guard special symbols
   # so instead of \.
   # you can write "."
   # etc 
   say "regexp: ^^ \"$i={config()<locale>}\" \".\" \"UTF-8\" \\s* \$\$";
}
RAKU
