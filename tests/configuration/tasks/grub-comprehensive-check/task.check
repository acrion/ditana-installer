note: comprehensive check of all GRUB settings

# Check all settings in order (not strict order since we don't use begin/end)
regexp: ^^ \s* "GRUB_TIMEOUT=20" \s* $$
regexp: ^^ \s* "GRUB_DISTRIBUTOR=\"Ditana\"" \s* $$
regexp: ^^ \s* "GRUB_CMDLINE_LINUX_DEFAULT=\"quiet splash loglevel=3 rd.systemd.show_status=false\"" \s* $$
regexp: ^^ \s* "GRUB_ENABLE_CRYPTODISK=y" \s* $$
regexp: ^^ \s* "GRUB_DISABLE_OS_PROBER=false" \s* $$
