note: collect modules info
~regexp: ^^ \s* "MODULES=(" (.*) ")" \s* $$
code: <<RAKU
!raku
RAKU

generator: <<CODE
!raku
my @mods;
if !matched() {
   say "assert: 0 MODULES= section found";
} else {
   my @mods = capture()[0].split(/s+/);
}
update_state(%( mods => @mods ))
CODE

note: collect hooks info
~regexp: ^^ \s* "HOOKS=(" (.*) ")" \s* $$

generator: <<CODE
!raku
my @hooks;
if !matched() {
   say "assert: 0 HOOKS= section found";
} else {
   my @hooks = capture()[0].split(/s+/);
}
my $s = get_state(); $s<hooks> = @hooks;
update_state($s)
CODE


note: check for mandotary hooks parameters

generator: <<CODE
!raku
my @mandotary-parameters = [
    "kms",
    "[udev || systemd]",
    "filesystems",
 ];

say q[within: ^^ "HOOKS=(" (.*) ")" \s* $$];
for @mandotary-parameters -> $i {
    say q[note: check mandotary hooks parameter %p%].subst("%p%",$i);
    say q[regexp: <?wb> %p% <?wb> ].subst("%p%",$i);
}
say "end:";
CODE


