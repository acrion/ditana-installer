note: check for mandotary hooks parameters

generator: <<CODE
!raku
my @mandotary-parameters = [
    "kms",
    "[udev || systemd]",
    "filesystems",
 ];

say q[within: ^^ "HOOKS=(" (.*) ")" \s* $$];
for @mandotary-parameters -> $i {
    say q[note: check mandotary hooks parameter %p%].subst("%p%",$i);
    say q[regexp: <?wb> %p% <?wb> ].subst("%p%",$i);
}
say "end:";
CODE


generator: <<CODE
!raku
my $hooks = config()<hooks>;
my $mods = config()<mods>;

if config()<with-zfs> {

   say q[note: zfs related checks];
   say q[note: ==================];

   say q[within: ^^ "HOOKS=(" (.*) ")" \s* $$];
   if not $hooks{"zfs"}:exists {
      say q[note: Insert "zfs" into HOOKS before "filesystems" if filesystem is zfs];
      say q[regexp: <?wb> zfs \s filesystems <?wb>];
   }

   say q[note: Remove "fsck" from HOOKS if filesystem is zfs];
   say q[!regexp: <?wb> fsck <?wb> ];
   say "end:";
   
   say q[note: Add "zfs" to MODULES if filesystem is zfs];
   say q[within: ^^ "MODULES=(" (.*) ")" \s* $$];
   say q[regexp: <?wb> zfs  <?wb> ];
   
   say "end:";
   say q[note: ==================];
}

if config()<encrypt-root-partition> {

   say q[note: encryption related checks];
   say q[note: ==================];

   say q[within: ^^ "HOOKS=(" (.*) ")" \s* $$];
   if not $hooks{"keyboard"}:exists {
      say q[note: For LUKS encryption on all init systems, add keyboard hook after kms hook];
      say q[regexp: <?wb> kms  \s keyboard <?wb>];
   }

   say "end:";
   say q[note: ==================];
}

if config()<nvidia-but-no-nouveau> {

   say q[note: nvidia related checks];
   say q[note: ==================];

   say q[within: ^^ "HOOKS=(" (.*) ")" \s* $$];
   say q[note: For NVIDIA drivers, except Nouveau, remove the kms hook];
   say q[!regexp: <?wb> kms <?wb>];
   say "end:";
   say q[note: ==================];
}

if config()<nvidia-but-no-nouveau> {

   say q[note: nvidia related checks];
   say q[note: ==================];

   say q[within: ^^ "HOOKS=(" (.*) ")" \s* $$];
   say q[note: For NVIDIA drivers, except Nouveau, remove the kms hook];
   say q[!regexp: <?wb> kms <?wb>];
   say "end:";
   say q[note: ==================];
}

CODE

