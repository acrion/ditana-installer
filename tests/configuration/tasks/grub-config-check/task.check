note: timeout should be set

generator: <<RAKU
!raku
say q[regexp: ^^ \s* "GRUB_TIMEOUT=" ], config()<timeout>, q[ \s* $$];

if config()<kernel_options> {
    say "note: kernel_options should be set";
    say 
    q|regexp: ^^ \s* "GRUB_CMDLINE_LINUX_DEFAULT="\"|, 
    " ",
    '"', config()<kernel_options>, '" \"', 
    q| \s* $$|;
}

if config()<enable_crypto_disk> {
    say "note: crypto disk should be enabled";
    say q|regexp: ^^ \s* "GRUB_ENABLE_CRYPTODISK=y" \s* $$|;
}

if config()<enable_os_prober> {
    say "note: os prober should be enabled";
    say q|regexp: ^^ \s* "GRUB_DISABLE_OS_PROBER=false" \s* $$|;
}

RAKU
