note: locale.conf should use C.UTF-8 for specific categories

generator: <<RAKU
!raku
my $locale = config()<locale>;

# Generate all patterns via generator (not as direct regexp: statements)
say "regexp: ^^ LC_COLLATE\\= C\\.UTF\\-8 \\s* \$\$";
say "regexp: ^^ LC_CTYPE\\= C\\.UTF\\-8 \\s* \$\$";
say "regexp: ^^ LC_MESSAGES\\= C\\.UTF\\-8 \\s* \$\$";
say "regexp: ^^ LC_NUMERIC\\= C\\.UTF\\-8 \\s* \$\$";
say "regexp: ^^ LANG\\= $locale\\.UTF\\-8 \\s* \$\$";
RAKU