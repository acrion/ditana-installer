note: Check required hooks are present

# Check for udev or systemd
~regexp: ^^ "HOOKS=" .* <?wb> ( udev || systemd ) <?wb>

generator: <<RAKU
!raku
if !matched() {
    die "ERROR: Neither 'udev' nor 'systemd' found in HOOKS";
}
say "note: Found udev or systemd in HOOKS";
RAKU

# Check for filesystems
~regexp: ^^ "HOOKS=" .* <?wb> filesystems <?wb>

generator: <<RAKU
!raku
if !matched() {
    die "ERROR: 'filesystems' not found in HOOKS";
}
say "note: Found filesystems in HOOKS";
RAKU

# Check for kms (unless nvidia_but_no_nouveau)
generator: <<RAKU
!raku
if config()<nvidia_but_no_nouveau> ne "y" {
    say '~regexp: ^^ "HOOKS=" .* <?wb> kms <?wb>';
}
RAKU

generator: <<RAKU
!raku
if config()<nvidia_but_no_nouveau> ne "y" and !matched() {
    die "ERROR: 'kms' not found in HOOKS";
}
say "note: kms check passed";
RAKU

# Collect current hooks information
note: Collecting current hooks information

generator: <<RAKU
!raku
my %hooks_rc;
my @checks = <udev systemd keyboard keymap consolefont encrypt sd-vconsole sd-encrypt zfs fsck>;

for @checks -> $hook {
    say "~regexp: ^^ \"HOOKS=\" .* <?wb> $hook <?wb>";
    say qq:to/CODE/;
    generator: <<RAKU2
    !raku
    my \$s = get_state() // %(); 
    \$s<hooks_rc> //= %();
    \$s<hooks_rc><$hook> = matched() ?? 0 !! 1;
    update_state(\$s);
    RAKU2
    CODE
}
RAKU

# Parse HOOKS line
~regexp: ^^ "HOOKS=" \s* "(" (.*) ")" \s* $$

generator: <<RAKU
!raku
my %hooks;
if matched() {
    my $hooks_str = capture()[0];
    for $hooks_str.words -> $hook {
        %hooks{$hook} = True;
    }
}
my $s = get_state() // %();
$s<hooks> = %hooks;
update_state($s);
RAKU

# Parse MODULES line  
~regexp: ^^ "MODULES=" \s* "(" (.*) ")" \s* $$

generator: <<RAKU
!raku
my %modules;
if matched() {
    my $modules_str = capture()[0];
    for $modules_str.words -> $mod {
        %modules{$mod} = True;
    }
}
my $s = get_state() // %();
$s<modules> = %modules;
update_state($s);
RAKU
