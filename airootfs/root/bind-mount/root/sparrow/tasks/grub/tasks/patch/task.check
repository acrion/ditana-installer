note: set GRUB_TIMEOUT

~regexp: ^^ \s* "GRUB_TIMEOUT=" .*

generator: <<RAKU
!raku
if matched() {
    say "assert: 1 GRUB_TIMEOUT parameter found: [{matched()}]";
    say "note: patching GRUB_TIMEOUT";
    replace(
        config()<path>,
        captures-full()[0]<index>,
        "GRUB_TIMEOUT={config()<timeout>}",
    );
} else {
    say "assert: 0 GRUB_TIMEOUT parameter found";
}
RAKU

note: set GRUB_CMDLINE_LINUX_DEFAULT

~regexp: ^^ \s* "GRUB_CMDLINE_LINUX_DEFAULT=" .*

generator: <<RAKU
!raku
if matched() {
    say "assert: 1 GRUB_CMDLINE_LINUX_DEFAULT parameter found: [{matched()}]";
    say "note: patching GRUB_CMDLINE_LINUX_DEFAULT";
    replace(
        config()<path>,
        captures-full()[0]<index>,
        "GRUB_CMDLINE_LINUX_DEFAULT=\"{config()<kernel_options>}\"",
    );
} else {
    say "assert: 0 GRUB_CMDLINE_LINUX_DEFAULT parameter found";
}
RAKU


note: set GRUB_DISTRIBUTOR

~regexp: ^^ \s* "GRUB_DISTRIBUTOR=" .*

generator: <<RAKU
!raku
if matched() {
    say "assert: 1 GRUB_DISTRIBUTOR parameter found: [{matched()}]";
    say "note: patching GRUB_DISTRIBUTOR";
    replace(
        config()<path>,
        captures-full()[0]<index>,
