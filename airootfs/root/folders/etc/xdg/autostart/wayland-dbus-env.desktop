[Desktop Entry]
Name=Wayland D-Bus Environment Updater
Comment=Update D-Bus activation environment with Wayland variables
Exec=dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP
Icon=preferences-system
Terminal=false
Type=Application
Categories=System;X-Wayland;
OnlyShowIn=wlroots;
NoDisplay=true
StartupNotify=false
