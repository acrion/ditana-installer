[Desktop Entry]
Name=Wayland Environment Initializer (Systemd)
Comment=Import Wayland environment variables into systemd user session
Exec=systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP
Icon=application-x-executable
Terminal=false
Type=Application
Categories=System;X-Wayland;
OnlyShowIn=wlroots;
NoDisplay=true
StartupNotify=false
