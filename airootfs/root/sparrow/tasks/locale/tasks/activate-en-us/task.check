note: activate-locale: looking for commented locale line

generator: <<RAKU
!raku
say q[~regexp: ^^ \s+ \d+ \s+ \x[23] "en_US.UTF-8" \s+ "UTF-8" \s* $$]
RAKU

generator: <<RAKU
!raku
if matched() {
    say "note: found commented en_US.UTF-8 line";
    replace( 
      config()<locale_gen_path>, 
      captures-full()[0]<index>, 
      "en_US.UTF-8 UTF-8" 
    );  
    say "note: activated locale en_US.UTF-8";
    say "note: file {config()<locale_gen_path>} updated";
} else {
    say "note: locale en_US.UTF-8 is already active";
}

RAKU
