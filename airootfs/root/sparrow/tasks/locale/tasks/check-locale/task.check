generator: <<RAKU
!raku
say "note: check locale";
say q[~regexp: ^^ \s*   \x[23]  \s*  %locale% '.UTF-8' \s+ 'UTF-8' \s* $$].
subst("%locale%", config()<locale>);
RAKU

generator: <<RAKU
!raku
if matched() {
    say "assert: 1 valid locale";
} else {
